{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "pnpm bench:transform && pnpm bench:serialize && pnpm bench:http && pnpm bench:upstream",
    "bench:transform": "tsx bench/transform.ts",
    "bench:serialize": "tsx bench/serialize.ts",
    "bench:http": "tsx bench/http.ts",
    "bench:upstream": "tsx bench/upstream.ts"
  },
  "dependencies": {
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^24.19.2",
    "autocannon": "^9.0.0",
    "eslint": "^9.39.5",
    "fast-json-stringify": "^7.3.5",
    "tinybench": "^6.2.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
